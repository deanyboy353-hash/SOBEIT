{
  "name": "Nudge",
  "short_name": "Nudge",
  "description": "Nudge: chores, work, training, food and games for two. After dark.",
  "display": "standalone",
  "background_color": "#0b0414",
  "theme_color": "#0b0414",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Log food", "short_name": "Log food", "description": "Type or snap what you ate", "url": "./#food:log", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Log weight", "short_name": "Log weight", "description": "Weigh-in", "url": "./#home:weigh", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Start gym session", "short_name": "Gym", "description": "Today's session, ready to log", "url": "./#train:start", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Today's chores", "short_name": "Chores", "description": "Your minimum and bonus jobs", "url": "./#chores", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "photo", "accept": ["image/*"] }] }
  }
}
