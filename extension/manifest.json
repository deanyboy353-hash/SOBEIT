{
  "manifest_version": 3,
  "name": "Life Quest",
  "short_name": "Life Quest",
  "version": "1.0.0",
  "description": "Your Life Quest app in Chrome's side panel: deadlines, chores and music while you work, plus right-click to add a deadline.",
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": { "default_title": "Life Quest", "default_icon": { "16": "icon-16.png", "48": "icon-48.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "options_page": "setup.html",
  "permissions": ["sidePanel", "contextMenus", "storage", "alarms", "notifications"],
  "host_permissions": ["https://script.google.com/*", "https://script.googleusercontent.com/*"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" }, "description": "Open Life Quest" }
  }
}
