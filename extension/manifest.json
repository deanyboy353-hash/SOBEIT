{
  "manifest_version": 3,
  "name": "Nudge",
  "short_name": "Nudge",
  "version": "1.4.0",
  "description": "Your Nudge app in Chrome's side panel: deadlines, chores and music while you work, plus right-click to add a deadline.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Open Nudge (right-click for the side panel)",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "setup.html",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://life-quest-5c52d.web.app/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Nudge"
    }
  }
}